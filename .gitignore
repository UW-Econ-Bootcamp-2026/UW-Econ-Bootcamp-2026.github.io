# ---------- Quarto / build ----------
/_site/
/.quarto/
.DS_Store
**/*.quarto_ipynb

# ---------- LaTeX build artifacts ----------
*.aux
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb

# ================================================================
# LEAK PROTECTION — keep unreleased course materials OUT of the
# public repo. Default = hidden. Un-ignore a file the SAME week you
# uncomment its matching line in _quarto.yml.
# ================================================================

# Never publish: LaTeX source, the archive, solutions, later-week data, figures
*.tex
archive/
homeworks/solutions/
homeworks/data/
lectures/figs/

# Lectures — hide all PDFs, then allow released weeks only
lectures/*.pdf
!lectures/lecture_one.pdf
!lectures/lecture_two.pdf

# Code-alongs — hide all scripts, then allow released weeks only
codealongs/*.jl
!codealongs/CodeAlong1.jl
!codealongs/CodeAlong2.jl

# Homeworks — hide all handouts, then allow released weeks only
homeworks/*.pdf
!homeworks/homework1.pdf

