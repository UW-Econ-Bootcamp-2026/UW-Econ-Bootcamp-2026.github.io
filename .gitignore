# ---------- Quarto / build ----------
/_site/
/.quarto/
.DS_Store
**/*.quarto_ipynb

# ---------- LaTeX build artifacts ----------
*.aux
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb

# ================================================================
# LEAK PROTECTION — keep unreleased course materials OUT of the
# public repo. Default = hidden. Un-ignore a file the SAME week you
# uncomment its matching line in _quarto.yml.
# ================================================================

# Never publish: LaTeX source, the archive, later-week data, figures
*.tex
archive/
homeworks/data/*
lectures/figs/

# Lectures — hide all PDFs, then allow released weeks only
lectures/*.pdf
!lectures/lecture_one.pdf
!lectures/lecture_two.pdf

# Code-alongs — hide all scripts and data, then allow released weeks only
codealongs/*.jl
codealongs/data/*
!codealongs/CodeAlong1.jl
!codealongs/CodeAlong2.jl

# Homeworks — hide all handouts, then allow released weeks only
homeworks/*.pdf
!homeworks/homework1.pdf

# Homework solutions — hide all, then allow released (past-due) homeworks only
homeworks/solutions/*
!homeworks/solutions/homework1_solution.jl
!homeworks/solutions/homework2_solution.jl

# ---- Weekly release checklist (uncomment as each week arrives) ----
# Week 2:
!lectures/lecture_three.pdf
!lectures/lecture_four.pdf
!codealongs/CodeAlong3.jl
!codealongs/CodeAlong4.jl
!homeworks/homework2.pdf
# Week 3:
!lectures/lecture_five.pdf
!lectures/lecture_six.pdf
!codealongs/CodeAlong5.jl
!codealongs/CodeAlong6.jl
!homeworks/homework3.pdf
# Week 4:
!lectures/lecture_seven.pdf
!lectures/lecture_eight.pdf
!codealongs/CodeAlong7.jl
!codealongs/CodeAlong8.jl
# CodeAlong8 reads wages.csv; make_wages.jl regenerates it
!codealongs/data/wages.csv
!codealongs/data/make_wages.jl
